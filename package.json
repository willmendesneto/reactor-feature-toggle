{
  "name": "reactor-feature-toggle",
  "version": "8.3.0",
  "description": "Your module to handle with feature toggles in ReactJS applications easier",
  "author": "Will Mendes <willmendesneto@gmail.com> (http://github.com/willmendesneto)",
  "keywords": [
    "react",
    "reactjs",
    "feature-toggle",
    "toggle",
    "flag",
    "feature-flag",
    "reactor-feature-toggle"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/willmendesneto/reactor-feature-toggle#readme",
  "bugs": {
    "url": "https://github.com/willmendesneto/reactor-feature-toggle/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmendesneto/reactor-feature-toggle.git"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/esm/client.d.ts",
        "default": "./dist/esm/client.js"
      },
      "require": {
        "types": "./dist/cjs/client.d.ts",
        "default": "./dist/cjs/client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:esm && npm run build:cjs",
    "build:clean": "rm -rf ./dist ./coverage",
    "build:esm": "tsc -p tsconfig.build.json --outDir dist/esm && echo \"{\\\"type\\\":\\\"module\\\"}\" > dist/esm/package.json",
    "build:cjs": "tsc -p tsconfig.build.json --module nodenext --moduleResolution nodenext --outDir dist/cjs && echo \"{\\\"type\\\":\\\"commonjs\\\"}\" > dist/cjs/package.json",
    "lint:package": "publint --strict --pack npm && attw --pack . --profile node16",
    "size": "size-limit",
    "lint": "eslint --ext .ts,.tsx,.js src/",
    "lint:fix": "eslint --ext .ts,.tsx,.js src/ --fix",
    "lint:types": "tsc --noEmit",
    "lint:types-watch": "tsc --noEmit --watch",
    "prepack": "npm run build -s",
    "test": "vitest --watch=false",
    "test:watch": "vitest --watch",
    "preversion": "npm run lint -s && npm run lint:types -s && npm run test -s",
    "version": "version-changelog CHANGELOG.md && changelog-verify CHANGELOG.md && git add CHANGELOG.md",
    "vc": "version-changelog CHANGELOG.md"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^16.9.35",
    "@types/react-dom": "^16.9.8",
    "@typescript-eslint/eslint-plugin": "^3.1.0",
    "@typescript-eslint/parser": "^3.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "changelog-verify": "^1.1.2",
    "confusing-browser-globals": "^1.0.9",
    "eslint": "^7.0.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-react": "^7.20.0",
    "eslint-plugin-react-hooks": "^4.0.2",
    "feature-toggle-service": "^7.0.1",
    "jsdom": "^27.2.0",
    "prettier": "^2.0.5",
    "publint": "^0.3.25",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.3",
    "version-changelog": "^3.1.1",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "feature-toggle-service": "^7.0.1",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "size-limit": [
    {
      "name": "reactor-feature-toggle",
      "path": "dist/esm/index.js",
      "import": "{ FeatureToggle }",
      "ignore": [
        "react",
        "feature-toggle-service"
      ],
      "limit": "250 B"
    },
    {
      "name": "reactor-feature-toggle/client",
      "path": "dist/esm/client.js",
      "import": "{ FeatureToggleProvider, useFeatureToggle }",
      "ignore": [
        "react",
        "feature-toggle-service"
      ],
      "limit": "300 B"
    }
  ]
}
