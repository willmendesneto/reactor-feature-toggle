{
  "name": "reactor-feature-toggle",
  "version": "9.0.0",
  "description": "Your module to handle with feature toggles in ReactJS applications easier",
  "author": "Will Mendes <willmendesneto@gmail.com> (http://github.com/willmendesneto)",
  "keywords": [
    "react",
    "reactjs",
    "feature-toggle",
    "toggle",
    "flag",
    "feature-flag",
    "reactor-feature-toggle"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/willmendesneto/reactor-feature-toggle#readme",
  "bugs": {
    "url": "https://github.com/willmendesneto/reactor-feature-toggle/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmendesneto/reactor-feature-toggle.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "lint:package": "publint --strict --pack npm && attw --pack . --profile node16",
    "size": "size-limit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "lint:types-watch": "tsc --noEmit --watch",
    "prepack": "npm run build -s",
    "test": "vitest --watch=false",
    "test:watch": "vitest --watch",
    "test:smoke": "node scripts/smoke-test.mjs",
    "preversion": "npm run lint -s && npm run format:check -s && npm run lint:types -s && npm run test -s",
    "version": "version-changelog CHANGELOG.md && changelog-verify CHANGELOG.md && git add CHANGELOG.md",
    "vc": "version-changelog CHANGELOG.md",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "changelog-verify": "^1.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "feature-toggle-service": "^8.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "version-changelog": "^3.1.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "feature-toggle-service": "^8.0.0",
    "react": ">=18.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "size-limit": [
    {
      "name": "reactor-feature-toggle",
      "path": "dist/index.mjs",
      "import": "{ FeatureToggle, FeatureToggleProvider, useFeatureToggle }",
      "ignore": [
        "react",
        "feature-toggle-service"
      ],
      "limit": "500 B"
    },
    {
      "name": "reactor-feature-toggle/client",
      "path": "dist/client.mjs",
      "import": "{ FeatureToggle, FeatureToggleProvider, useFeatureToggle }",
      "ignore": [
        "react",
        "feature-toggle-service"
      ],
      "limit": "500 B"
    }
  ]
}
